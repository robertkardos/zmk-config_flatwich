#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Base";
            bindings = <
                &kp GRAVE  &kp N1    &kp N2  &kp N3    &kp N4  &kp N5  &kp N6              &kp N7       &kp N8     &kp N9    &kp N0     &kp MINUS  &kp  EQUAL  &kp BSPC
                &kp TAB    &kp Q     &kp W   &kp E     &kp R   &kp T   &kp Y               &kp U        &kp I      &kp O     &kp P      &kp LBKT   &kp  RBKT   &kp DEL
                &kp ESC    &kp A     &kp S   &kp D     &kp F   &kp G   &kp H               &kp J        &kp K      &kp L     &kp SEMI   &kp APOS   &kp  BSLH   &kp RET
                &kp LSHFT  &kp Z     &kp X   &kp C     &kp V   &kp B   &kp N               &kp M        &kp COMMA  &kp DOT   &kp FSLH   &kp NUBS   &kp  UP     &kp RSHFT
                &kp LCTRL  &kp LGUI  &mo 2   &kp LALT  &mo 1   &mo 3   &kp SPACE           &kp K_CMENU  &kp RALT   &kp RGUI  &kp RCTRL  &kp LEFT   &kp  DOWN   &kp RIGHT
            >;
        };

        navcluster { // Layer 1
            display-name = "Navcluster";
            bindings = <
                &trans  &kp BSPC  &kp RET   &kp DEL    &none  &none     &none             &none     &none  &none  &none  &none  &none  &none
                &trans  &kp HOME  &kp UP    &kp PG_UP  &none  &none     &none             &none     &none  &none  &none  &none  &none  &none
                &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none     &none             &none     &none  &none  &none  &none  &none  &none
                &trans  &kp END   &none     &kp PG_DN  &none  &none     &none             &none     &none  &none  &none  &none  &none  &none
                &trans  &trans    &none     &trans     &none  &kp SLCK  &kp PSCRN         &kp CAPS  &none  &none  &none  &none  &none  &none
            >;
        };

        numpad { // Layer 2
            display-name = "Numpad";
            bindings = < 
                &kp KP_NLCK   &kp BSPC    &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS  &none         &none               &none     &none  &none  &none  &none  &none  &none
                &none         &kp KP_N7   &kp KP_N8     &kp KP_N9        &kp KP_PLUS   &none         &none               &none     &none  &none  &none  &none  &none  &none
                &none         &kp KP_N4   &kp KP_N5     &kp KP_N6        &kp EQUAL     &kp C_BRI_UP  &kp C_VOL_UP        &none     &none  &none  &none  &none  &none  &none
                &none         &kp KP_N1   &kp KP_N2     &kp KP_N3        &kp KP_ENTER  &kp C_BRI_DN  &kp C_VOL_DN        &none     &none  &none  &none  &none  &none  &none
                &kp KP_COMMA  &kp KP_DOT  &none         &kp KP_N0        &none         &none         &kp C_MUTE          &kp CAPS  &none  &none  &none  &none  &none  &none
            >;
        };

        funcion { // Layer 3
            display-name = "Function";
            bindings = <
                &bt BT_SEL 0  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6          &bt BT_DISC 0  &none  &none  &none           &none       &none  &bt BT_CLR
                &bt BT_SEL 1  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12         &bt BT_DISC 1  &none  &none  &none           &none       &none  &bt BT_CLR
                &bt BT_SEL 2  &none   &none   &none   &none    &none    &none           &bt BT_DISC 2  &none  &none  &bt BT_CLR_ALL  &none       &none  &none
                &bt BT_SEL 3  &none   &none   &none   &none    &none    &none           &bt BT_DISC 3  &none  &none  &none           &none       &none  &none
                &bt BT_SEL 4  &none   &none   &none   &none    &none    &none           &bt BT_DISC 4  &none  &none  &none           &bt BT_PRV  &none  &bt BT_NXT
            >;
        };
    };
 };