#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            display-name = "Base";
            bindings = <
                &kp GRAVE  &kp N1   &kp N2   &kp N3    &kp N4    &kp N5    &kp N6              &kp N7      &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB    &kp Q    &kp W    &kp E     &kp R     &kp T     &kp Y               &kp U       &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp DEL
                &kp ESC    &kp A    &kp S    &kp D     &kp F     &kp G     &kp H               &kp J       &kp K     &kp L     &kp SEMI  &kp APOS  &kp BSLH  &kp RET
                &kp LSHFT  &kp Z    &kp X    &kp C     &kp V     &kp B     &kp N               &kp M       &kp COMMA &kp DOT   &kp FSLH  &kp NUBS  &kp UP    &kp RSHFT
                &kp LCTRL  &kp LGUI &mo 2    &kp LALT  &mo 1     &mo 3     &kp SPACE           &kp K_CMENU &kp RALT  &kp RGUI  &kp RCTRL &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        navcluster { // Layer 1
            display-name = "Navcluster";
            bindings = <
                &kp &none &kp BSPC  &kp RET   &kp DEL   &kp &none &kp &none &kp &none          &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp HOME  &kp UP    &kp PG_UP &kp &none &kp &none &kp &none          &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp LEFT  &kp DOWN  &kp RIGHT &kp &none &kp &none &kp &none          &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp END   &kp &none &kp PG_DN &kp &none &kp &none &kp &none          &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp &none &kp &none &kp &none &kp &none &kp SLCK  &kp PSCRN          &kp CAPS  &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
            >;
        };

        numpad { // Layer 2
            display-name = "Numpad";
            bindings = <
                &kp KP_NLCK  &kp BSPC   &kp KP_SLASH &kp KP_ASTERISK &kp KP_MINUS &kp &none    &kp &none        &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none    &kp KP_N7  &kp KP_N8    &kp KP_N9       &kp KP_PLUS  &kp &none    &kp &none        &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none    &kp KP_N4  &kp KP_N5    &kp KP_N6       &kp EQUAL    &kp C_BRI_UP &kp C_VOL_UP     &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none    &kp KP_N1  &kp KP_N2    &kp KP_N3       &kp KP_ENTER &kp C_BRI_DN &kp C_VOL_DN     &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp KP_COMMA &kp KP_DOT &kp &none    &kp KP_N0       &kp &none    &kp &none    &kp C_MUTE       &kp CAPS &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
            >;
        };

        funcion { // Layer 3
            display-name = "Function";
            bindings = <
                &kp &none &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6              &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12             &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none           &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none           &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
                &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none           &kp CAPS  &kp &none &kp &none &kp &none &kp &none &kp &none &kp &none
            >;
        };


    };
 };